# ── Barr backend configuration (copy to backend/.env or set in your platform) ──
NODE_ENV=development
PORT=4000
# Runtime role (subject to row-level security) and migration/owner role.
DATABASE_URL=postgres://barr_app:barr_app@localhost:5432/barr
MIGRATION_DATABASE_URL=postgres://barr_owner:barr_owner@localhost:5432/barr
# Hosting region is CONFIG — decided after legal review. No region-specific code.
DATA_REGION=unset
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32 random bytes, base64:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=change-me
PUBLIC_BASE_URL=http://localhost:4000
DASHBOARD_ORIGIN=http://localhost:5173
# Dev only: accept this fixed OTP (refused in production)
DEV_FIXED_OTP=123456

# Payments: fake | paytabs  (Tap Payments adapter planned — same interface)
PAYMENT_PROVIDER=fake
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION_URL=https://secure-egypt.paytabs.com

# WhatsApp Business: console | meta (Cloud API)
MESSAGING_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# SMS (sign-in codes, escalation fallback) and calls to on-call doctor: console | twilio
SMS_PROVIDER=console
CALLING_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push: console | expo
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

# Object storage (photos, receipts): local | s3 (any S3-compatible)
STORAGE_PROVIDER=local
S3_BUCKET=barr-media
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth audiences
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=app.barr.family,app.barr.field

# PDF rendering (Chromium shapes Arabic correctly)
CHROMIUM_PATH=/usr/bin/chromium

# ── Mobile (apps/mobile, EXPO_PUBLIC_* are embedded in the app) ──
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# EXPO_PUBLIC_HELP_LINE=+20XXXXXXXXXX
# EXPO_PUBLIC_SENTRY_DSN=
# APP_VARIANT=family|field
