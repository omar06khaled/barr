{
  "name": "@barr/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@barr/shared": "workspace:*",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "3.25.76",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}